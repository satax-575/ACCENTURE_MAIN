# =============================================================================
# KPI Intelligence Engine — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (it is in .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider — pick ONE of the following (first set key wins)
# ---------------------------------------------------------------------------

# OPTION A: Groq (RECOMMENDED — completely free, fastest inference, no credit card)
# Get key at: https://console.groq.com  → API Keys → Create API Key
# Free tier: 6000 RPM for 8B model, 100 RPM for 70B model
GROQ_API_KEY=

# OPTION B: Anthropic Claude Haiku (free $5 credit on signup, then pay-as-you-go)
# Get key at: https://console.anthropic.com → API Keys
# Claude Haiku = $0.80/M input tokens, $4.00/M output tokens
ANTHROPIC_API_KEY=

# OPTION C: Google Gemini Flash (free via AI Studio, no credit card)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTION D: OpenRouter (aggregates 100+ models, free models available)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Real Action Dispatch Integrations (all optional — simulated if not set)
# ---------------------------------------------------------------------------

# Slack: Create a free incoming webhook at:
# https://api.slack.com/messaging/webhooks → "Create your Slack app" → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Jira: Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ENG

# ---------------------------------------------------------------------------
# Real External Data Enrichment (optional)
# ---------------------------------------------------------------------------

# Alpha Vantage — real daily retail volume multiplier (TGT as proxy)
# Free tier: 25 API calls/day, no credit card required
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Custom webhook for any other system
CUSTOM_WEBHOOK_URL=
